{
  "manifest_version": 3,
  "name": "FlashDeck",
  "version": "1.0.0",
  "description": "Beautiful flashcards & quizzes — study smarter.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlashDeck",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
